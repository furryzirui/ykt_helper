<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local/custom AI providers may use HTTP; Rain Classroom URLs stay HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
